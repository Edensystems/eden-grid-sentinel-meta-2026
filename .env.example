# Copy to .env and fill in. Never commit a populated .env file.
EDEN_ENV=development
LOG_LEVEL=INFO

# --- Sense/Think/Learn/Act pipeline ---
FIREBASE_DB_URL=https://<project-id>-default-rtdb.firebaseio.com/
PROJECT_ID=<gcp-project-id>
COMMUNITY_ID=community_001
# Local only: path to a service-account key kept OUTSIDE the repo.
# On Cloud Run, leave unset and use the attached service account.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/eden-sa.json

# --- Grid Sentinel (hackathon). Not read by any code yet; no model calls before M2. ---
DATA_MODE=simulation
EDEN_REQUIRE_HUMAN_APPROVAL=true
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
MODEL_API_SEGMENTATION_MODEL=sam-3.1
MODEL_API_KEY=
