# Simulation-only read API. No model or Firebase dependencies at runtime.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /app
COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir . && useradd --create-home --uid 10001 sentinel
USER sentinel
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn eden.sentinel.m5_readonly:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
