# Node server-side ONLY; never prefix this variable with NEXT_PUBLIC_.
# The staging backend must run eden.sentinel.m5_readonly:app, NOT the M4 operator API.
SENTINEL_API_BASE_URL=http://127.0.0.1:8000

# Optional loopback operator mode (Incident panel). Server-only; never prefix with NEXT_PUBLIC_.
# Leave unset for the read-only preview. See docs/hackathon/INCIDENT_PANEL.md.
# SENTINEL_OPERATOR_API_BASE_URL=http://127.0.0.1:8001
# SENTINEL_OPERATOR_TOKEN=<throwaway local token, 20+ chars>
